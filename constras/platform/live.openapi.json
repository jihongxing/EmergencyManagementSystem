{
  "openapi": "3.1.0",
  "info": {"title": "Process liveness", "version": "0.1.0"},
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "description": "Process liveness only, not database or business readiness.",
        "security": [],
        "responses": {
          "200": {
            "description": "Process is responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "additionalProperties": false,
                  "properties": {"status": {"type": "string", "const": "alive"}}
                }
              }
            }
          }
        }
      }
    }
  }
}
