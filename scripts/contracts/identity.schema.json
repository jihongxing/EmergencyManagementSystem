{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "clauses", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^C02-[0-9]{2}$"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "member", "target", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "member": {
            "type": "object",
            "required": ["userId", "organizationId", "organizationKind", "active", "roles"],
            "additionalProperties": false,
            "properties": {
              "userId": {"type": "string"},
              "organizationId": {"type": "string"},
              "organizationKind": {"type": "string", "minLength": 1},
              "active": {"type": "boolean"},
              "roles": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "target": {"type": "string"},
          "expected": {
            "enum": ["allowed", "role_denied", "inactive", "scope_denied", "invalid_identity"]
          }
        }
      }
    }
  }
}
