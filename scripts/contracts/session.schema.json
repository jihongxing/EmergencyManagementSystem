{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "module", "source", "policies", "manualClauses"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "module": {"const": "identity-session"},
    "source": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C(02|05)-[0-9]{2}$"}},
    "manualClauses": {"type": "array", "items": {"type": "string", "pattern": "^C(02|05)-[0-9]{2}$"}},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "clauses", "facts", "allowWhen", "cases"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "clauses": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C(02|05)-[0-9]{2}$"}},
          "facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "allowWhen": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "cases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["name", "input", "allowed"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "input": {"type": "object", "additionalProperties": {"type": "boolean"}},
                "allowed": {"type": "boolean"}
              }
            }
          }
        }
      }
    }
  }
}
