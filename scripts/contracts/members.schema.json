{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "module", "source", "operations", "cases", "auditActions"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "module": {"const": "identity-members"},
    "source": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "operations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "method", "path", "requires"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "method": {"enum": ["GET", "POST", "PATCH"]},
          "path": {"type": "string"},
          "requires": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "creates": {"type": "object", "additionalProperties": true},
          "protects": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "allowed"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string"}, "allowed": {"type": "boolean"}}
      }
    },
    "auditActions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
